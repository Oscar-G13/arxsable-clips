      "tinypool": "2.1.2",
      "minimatch@>=9 <10": "9.0.9",
      "minimatch@>=3 <4": "3.1.5",
      "js-yaml": "4.3.2",
      "zod": "4.6.7",
      "esbuild": "0.28.1",
      "effect": "3.22.1",
      "vite": "8.3.8"
    }
  }
