[Unit]
Description=Publish Arx Clips operational status
After=docker.service network-online.target
Wants=network-online.target
ConditionFileIsExecutable=/opt/supoclip/app/ops/status.sh

[Service]
Type=oneshot
User=oscar
Group=oscar
Environment=HOME=/home/oscar
WorkingDirectory=/opt/supoclip/app
ExecStart=/opt/supoclip/app/ops/status.sh
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
TimeoutStartSec=30min
