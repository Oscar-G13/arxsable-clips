    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.532.0",
    "mediabunny": "^1.66.2",
    "motion": "^14.14.0",
    "next": "15.5.29",
    "next-intl": "^4.15.3",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.453.2",
    "posthog-node": "^5.74.0",
    "prisma": "^6.19.3",
    "radix-ui": "^1.8.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "sonner": "^2.0.8",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "jsdom": "^27.4.0",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.1.1",
    "wait-on": "^8.0.5",
    "vite": "8.3.8"
  },
  "pnpm": {
