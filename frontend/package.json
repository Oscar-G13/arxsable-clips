{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "next dev --turbopack --port 3107",
    "build": "prisma generate && next build",
    "start": "next start --port 3107",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "prisma migrate deploy && playwright test",
    "test:e2e:headed": "prisma migrate deploy && playwright test --headed",
    "postinstall": "prisma generate",
    "typecheck": "prisma generate && tsc --noEmit",
    "test:polish": "playwright test --config playwright.polish.config.ts",
    "test:local": "playwright test --config playwright.local.config.ts"
  },
  "dependencies": {
    "@posthog/nextjs-config": "^1.12.2",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-alert-dialog": "^1.2.1",
